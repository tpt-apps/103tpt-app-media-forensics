# Rust
/target/
**/target/

# Tauri
/src-tauri/target/
/dist/

# Tauri-generated capability schemas. `tauri-build` regenerates these from
# `capabilities/*.json` on every build, and they are derived from the plugin
# set rather than authored, so committing them would mean a stale copy could
# disagree with the permissions the build actually grants.
/crates/tpt-app-media-forensics-tauri/gen/schemas/

# Node (Tauri frontend tooling)
node_modules/
.pnpm-store/

# IDE / editor
.vscode/
.idea/
*.iml

# OS
.DS_Store
Thumbs.db

# Env / secrets
.env
.env.*
*.pem
*.key

# Case data / local test artifacts (should not be committed)
*.tptcase
/fixtures/local/
/cache/

# Logs
*.log

# Editor swap/backup files
*~
*.orig
*.rej
# proptest regression seeds are local artefacts here: the only failure this file
# ever recorded came from a deliberately weakened assertion, and checking one in
# would imply a real defect had been found.
*.proptest-regressions
